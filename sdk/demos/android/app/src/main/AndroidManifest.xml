<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Chat tab talks to the dev server on this Mac (10.0.2.2 from the emulator), over plain
         http. Demo only: a real app uses https. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:usesCleartextTraffic="true"
        android:name=".DemoApp"
        android:label="Prism"
        android:theme="@style/Theme.Demo">
        <!-- uiMode handled in place: proves the widgets redraw light/dark without a reload. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ViewsActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:label="Views screen"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
