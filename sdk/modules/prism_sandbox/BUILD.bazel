load("@valdi//bzl/valdi:valdi_module.bzl", "valdi_module")

# prism_sandbox: runs the AI's code in its own JavaScript context (a Valdi Worker: separate
# context, separate thread), away from the drawing code.
valdi_module(
    name = "prism_sandbox",
    srcs = glob(["src/**/*.ts"]),
    visibility = ["//visibility:public"],
    deps = [
        "//modules/prism_core",
        "@valdi//src/valdi_modules/src/valdi/valdi_core",
        "@valdi//src/valdi_modules/src/valdi/worker",
    ],
)
