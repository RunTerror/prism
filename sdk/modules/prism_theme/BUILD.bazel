load("@valdi//bzl/valdi:valdi_module.bzl", "valdi_module")

# prism_theme: design tokens for drawing (colours light + dark, spacing, type, radii).
# Like Valdi's valdi_ui_theme. No drawing here.
# src/TokensSource.ts is GENERATED by scripts/embed-core.sh from core/dist/tokens.json.
valdi_module(
    name = "prism_theme",
    srcs = glob(["src/**/*.ts"]),
    visibility = ["//visibility:public"],
    deps = ["@valdi//src/valdi_modules/src/valdi/valdi_core"],
)
