# OS and editors
.DS_Store
.idea/
.vscode/
*.iml
xcuserdata/
.claude/settings.local.json

# Dependencies and build output
node_modules/
build/
.build/
.swiftpm/
DerivedData/
*.xcresult
.gradle/
.kotlin/
local.properties
*.log

# Bazel / Valdi workspace output
bazel-*
poc/sdk/out/

# The built SDK (xcframework, aar): published as release files, not kept in git.
# Rebuild with poc/sdk/scripts/build-sdk.sh.
poc/sdk/dist/

# Generated by tools: poc/core `npm run build`, xcodegen
poc/core/dist/
*.xcodeproj/

# Local chat logs from the dev server (real prompts and replies)
poc/server/logs/

# Screenshots the UI tests write on every run
poc/sdk/demos/*/screenshots/

# Generated from poc/core by poc/sdk/scripts/embed-core.sh (build-sdk.sh runs it)
poc/sdk/modules/prism_core/src/PrismRuntimeSource.ts
poc/sdk/modules/prism_theme/src/TokensSource.ts

# Old code kept on the author's machine only
poc/_archive/

# Screenshots the smoke tests write on every run
poc/sdk/screenshots/
poc/web/screenshots/
poc/electron/screenshots/

# Release files made by poc/sdk/scripts/package-release.sh (uploaded, not kept in git)
poc/sdk/release/
