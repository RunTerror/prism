# OS and editors
.DS_Store
.idea/
.vscode/
*.iml
xcuserdata/
.claude/settings.local.json

# Dependencies and build output
node_modules/
build/
.build/
.swiftpm/
DerivedData/
*.xcresult
.gradle/
.kotlin/
local.properties
