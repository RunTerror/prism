# Bazel / Valdi workspace output
bazel-*
sdk/out/

# The built SDK (xcframework, aar): published as release files, not kept in git.
# Rebuild with sdk/scripts/build-sdk.sh.
sdk/dist/

# Generated by tools: core `npm run build`, xcodegen
core/dist/
*.xcodeproj/

# Local chat logs from the dev server (real prompts and replies)
server/logs/

# Screenshots the UI tests write on every run
sdk/demos/*/screenshots/

# Generated from core by sdk/scripts/embed-core.sh (build-sdk.sh runs it)
sdk/modules/prism_core/src/PrismRuntimeSource.ts
sdk/modules/prism_theme/src/TokensSource.ts

# Old code kept on the author's machine only
_archive/

# Screenshots the smoke tests write on every run
sdk/screenshots/
web/screenshots/
electron/screenshots/

# Release files made by sdk/scripts/package-release.sh (uploaded, not kept in git)
sdk/release/
