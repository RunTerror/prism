<Card title="Exercise" subtitle="Loops · 5 minutes">
  <Text>Print every even number from 2 to 10.</Text>
  <Reveal label="Show the answer">
    <Code language="python" code={"for n in range(2, 11, 2):\n    print(n)"} />
    <Text secondary>range(start, stop, step): stop is not included, so use 11.</Text>
  </Reveal>
</Card>
